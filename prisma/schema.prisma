generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String   // 加密存储
  name        String?
  avatar      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  role        RoleType  @default(USER)  // 直接使用枚举


  // 可选: 用于跟踪用户的其他信息
  lastLoginAt DateTime?
  metadata    Json?


  inviteCode InviteCode[]
}

model BusinessUser {
    id          String   @id @default(cuid())
    name        String
    image       String?
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt


    // quizId     String
    // selectedQuiz  Quiz     @relation(fields: [quizId], references: [id])

}
model EncryptedData {
  id         String   @id @default(cuid())
  ciphertext String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  slug       String?  @unique
  shortLink  ShortLink? @relation(fields: [slug], references: [slug])

  metadata   Json?
}

model ShortLink {
  id         String        @id @default(nanoid(10))
  slug       String?       @unique @default(nanoid(10))
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  encryptedDataId String? @unique
  encryptedData EncryptedData?
}

model InviteCode {
  id         String   @id @default(cuid())
  code       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expirationDate DateTime

  metadata   Json?
  userId     String


  user       User     @relation(fields: [userId], references: [id])

}

// QuizClass 和 Quiz 是多对多的关系
model QuizClass {
  id         String   @id @default(cuid())
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // Add relation to Quiz through junction table
  quizzes    QuizToClass[]
  metadata   Json?
}
model Quiz {
  id         String     @id @default(cuid())
  parentId   String?    // 用于支持多级题目
  quiz       String     @db.Text
  type       QuizType   @default(RADIO)
  category   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Add relation to QuizClass through junction table
  classes    QuizToClass[]
  options    Option[]
  optionAnswers    OptionAnswer[]
  image      String?
  quizIndex  Int?
  metadata   Json?
}


model QuizToClass {
  quizId      String
  quiz        Quiz       @relation(fields: [quizId], references: [id])
  classId     String
  quizClass   QuizClass  @relation(fields: [classId], references: [id])
  assignedAt  DateTime   @default(now())

  @@id([quizId, classId])
  @@index([quizId])
  @@index([classId])
}

model Option {
  id         String   @id @default(cuid())
  content    String   @db.Text
  isAnswer   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  quizId     String
  quiz       Quiz     @relation(fields: [quizId], references: [id])
}

model OptionAnswer {
  id         String   @id @default(cuid())
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  quizId     String
  quiz       Quiz     @relation(fields: [quizId], references: [id])

  metadata   Json?    
}

enum QuizType {
  RADIO
  MULTIPLE
}

enum RoleType {
  SUPER_ADMIN
  ADMIN
  USER
  GUEST
  BANNED
}