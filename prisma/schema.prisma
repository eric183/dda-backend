generator client {
  provider = "prisma-client-js"
  path     = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String
  name        String?
  avatar      String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lastLoginAt DateTime?
  metadata    Json?
  role        RoleType     @default(USER)
  inviteCode  InviteCode[]
}

model BusinessUser {
  id        String   @id @default(cuid())
  name      String
  image     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EncryptedData {
  id         String     @id @default(cuid())
  ciphertext String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  slug       String?    @unique
  metadata   Json?
  shortLink  ShortLink? @relation(fields: [slug], references: [slug])
}

model ShortLink {
  id              String         @id @default(nanoid(10))
  slug            String?        @unique @default(nanoid(10))
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  encryptedDataId String?        @unique
  encryptedData   EncryptedData?
}

model InviteCode {
  id             String   @id @default(cuid())
  code           String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expirationDate DateTime
  metadata       Json?
  userId         String
  user           User     @relation(fields: [userId], references: [id])
}

model QuizCategory {

    id        Int       @id @default(autoincrement()) 
    name      String    // 分类名称
    quizzes   Quiz[]
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
}

model Quiz {
  id         Int       @id @default(autoincrement())
  name       String    // 题型名称
  categoryId    Int       
  category      QuizCategory @relation(fields: [categoryId], references: [id])
  image         String?
  questions  Question[] // 关联的题目
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Question {
  id         Int       @id @default(autoincrement())
  content    String    // 题目内容
  typeId     Int
  quizId     Int
  quiz       Quiz      @relation(fields: [quizId], references: [id])
  options    Option[]  // 关联的选项
  answer     String    // 正确答案
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Option {
  id        String   @id @default(cuid())
  content   String
  isAnswer  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  questionId Int
  question   Question  @relation(fields: [questionId], references: [id])
}

model OptionAnswer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quizId    String
  metadata  Json?
  content   String
}

enum QuizType {
  RADIO
  MULTIPLE
}

enum RoleType {
  SUPER_ADMIN
  ADMIN
  USER
  GUEST
  BANNED
}
