generator client {
  provider = "prisma-client-js"
  path     = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String
  name        String?
  avatar      String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lastLoginAt DateTime?
  metadata    Json?
  role        RoleType     @default(USER)
  inviteCode  InviteCode[]
}

model BusinessUser {
  id        String   @id @default(cuid())
  name      String
  image     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EncryptedData {
  id         String     @id @default(cuid())
  ciphertext String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  slug       String?    @unique
  metadata   Json?
  shortLink  ShortLink? @relation(fields: [slug], references: [slug])
}

model ShortLink {
  id              String         @id @default(nanoid(10))
  slug            String?        @unique @default(nanoid(10))
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  encryptedDataId String?        @unique
  encryptedData   EncryptedData?
}

model InviteCode {
  id             String   @id @default(cuid())
  code           String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expirationDate DateTime
  metadata       Json?
  userId         String
  user           User     @relation(fields: [userId], references: [id])
}

model QuizCategory {

  id        String   @id @default(cuid())
  name      String    // 分类名称 
  quizzes   Quiz[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  image     String?
  @@unique([name])
}

model Quiz {
  id         String   @id @default(cuid())
  name       String    // 题型名称
  categoryId    String       
  category      QuizCategory @relation(fields: [categoryId], references: [id])
  // quizIndex     Int?
  questions  Question[] // 关联的题目
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Question {
  questionIndex Int
  id         String   @id @default(cuid())
  content    String    // 题目内容
  // typeId     Int
  quizId     String
  image         String?
  quiz       Quiz      @relation(fields: [quizId], references: [id])
  options    Option[]  // 关联的选项
  optionAnswers OptionAnswer[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Option {
  id        String   @id @default(cuid())
  optionIndex Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  questionId String
  question   Question  @relation(fields: [questionId], references: [id])
}

model OptionAnswer {
  id        String   @id @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  questionId String
  question   Question  @relation(fields: [questionId], references: [id])
  metadata  Json?
  content   String
  optionAnswerIndex Int
}

enum QuizType {
  RADIO
  MULTIPLE
}

enum RoleType {
  SUPER_ADMIN
  ADMIN
  USER
  GUEST
  BANNED
}
